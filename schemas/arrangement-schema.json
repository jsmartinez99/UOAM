{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uoam.example.com/schemas/arrangement-schema.json",
  "title": "Musical Arrangement Schema",
  "description": "Schema for declaring musical arrangement structure for verification",
  "type": "object",
  "required": ["metadata", "sections"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "composer", "time_signature", "global_tempo_bpm", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "composer": { "type": "string", "minLength": 1 },
        "time_signature": { "type": "string", "pattern": "^\\d+/\\d+$" },
        "global_tempo_bpm": { "type": "number", "minimum": 20, "maximum": 300 },
        "duration_seconds": { "type": "number", "minimum": 1 },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "boundary_measures": { "type": "number", "minimum": 0, "maximum": 4, "default": 1 },
            "dynamic_lufs": { "type": "number", "minimum": 0, "maximum": 10, "default": 3 },
            "harmonic_similarity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "label", "start_measure", "end_measure",
          "tempo_bpm", "time_signature", "dynamics",
          "instrumentation", "density_percent", "harmonic_content"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "start_measure": { "type": "integer", "minimum": 1 },
          "end_measure": { "type": "integer", "minimum": 1 },
          "tempo_bpm": { "type": "number", "minimum": 20, "maximum": 300 },
          "time_signature": { "type": "string", "pattern": "^\\d+/\\d+$" },
          "dynamics": {
            "type": "string",
            "enum": ["ppp", "pp", "p", "mp", "mf", "f", "ff", "fff"]
          },
          "dynamics_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "instrumentation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "violin", "viola", "cello", "double_bass",
                "flute", "oboe", "clarinet", "bassoon",
                "horn", "trumpet", "trombone", "tuba",
                "timpani", "percussion",
                "piano", "harp", "synthesizer",
                "voice_soprano", "voice_alto", "voice_tenor", "voice_bass"
              ]
            }
          },
          "density_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "harmonic_content": {
            "type": "object",
            "required": ["progression", "key", "mode", "cadence_type"],
            "additionalProperties": false,
            "properties": {
              "progression": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(I|II|III|IV|V|VI|VII)(b|#)?(maj|min|dim|aug|7|maj7|m7|dim7|hdim7|sus2|sus4|6|9|11|13)?(/[IViv]+)?$"
                }
              },
              "key": {
                "type": "string",
                "pattern": "^[A-G](#|b)?$"
              },
              "mode": { "type": "string", "enum": ["major", "minor"] },
              "cadence_type": {
                "type": "string",
                "enum": ["authentic", "plagal", "half", "deceptive", "none"]
              },
              "fade_out": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}