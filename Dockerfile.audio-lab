# Audio Analysis Laboratory Docker Image
# Based on Ubuntu 24.04 with all audio analysis tools pre-installed

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    libfftw3-dev \
    libsndfile1-dev \
    libsamplerate0-dev \
    libtag1-dev \
    libchromaprint-dev \
    libvamp-hostsdk3v5 \
    vamp-plugin-sdk \
    python3-dev \
    python3-pip \
    python3-venv \
    git \
    curl \
    wget \
    unzip \
    software-properties-common \
    sonic-visualiser \
    audacity \
    && rm -rf /var/lib/apt/lists/*

# Install Chordino Vamp plugin
RUN cd /tmp && \
    git clone --depth 1 https://github.com/cannam/chordino.git && \
    cd chordino && \
    make -j$(nproc) 2>/dev/null || true && \
    make install 2>/dev/null || true && \
    cd / && rm -rf /tmp/chordino

# Create working directory
WORKDIR /workspace

# Create Python virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install core scientific Python packages
RUN pip install --no-cache-dir \
    numpy \
    scipy \
    matplotlib \
    pandas \
    librosa \
    pyloudnorm \
    typer \
    jinja2 \
    weasyprint \
    jsonschema \
    plotly \
    kaleido

# Install Essentia (try wheel first, fallback to conda-forge)
RUN pip install --no-cache-dir essentia-standard 2>/dev/null || \
    pip install --no-cache-dir --index-url https://pypi.anaconda.org/simple essentia 2>/dev/null || \
    echo "WARNING: Essentia may need manual installation"

# Install madmom
RUN pip install --no-cache-dir madmom 2>/dev/null || \
    echo "WARNING: madmom may need additional dependencies"

# Verify installations
RUN python3 -c "
import sys
pkgs = ['librosa', 'essentia', 'madmom', 'pyloudnorm', 'numpy', 'scipy', 'matplotlib', 'pandas', 'typer', 'jinja2', 'weasyprint', 'jsonschema', 'plotly']
for p in pkgs:
    try:
        __import__(p)
        print(f'{p}: OK')
    except ImportError as e:
        print(f'{p}: MISSING - {e}')
"

# Verify Sonic Visualiser and Vamp
RUN sonic-visualiser --version && vamp-simple-host -l

# Verify Audacity
RUN audacity --version

# Set default command
CMD ["/bin/bash"]